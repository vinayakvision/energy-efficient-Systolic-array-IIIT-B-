// ============================================================
// Formal Properties for int8_to_int32_decompressor (Jasper-safe)
// ============================================================

module decompressor_properties (
    input logic signed [7:0]   in_w,
    input logic [31:0]         scale,
    input logic signed [31:0]  out_w
);

    // ========================================================
    // Immediate (combinational) assertions
    // ========================================================
    always_comb begin

        // ----------------------------------------------------
        // 1. SIGN EXTENSION CORRECTNESS
        // ----------------------------------------------------
        assert (out_w[31] == in_w[7])
            else $error("Sign-extension error in decompressor");

        // ----------------------------------------------------
        // 2. ZERO PRESERVATION
        // ----------------------------------------------------
        if (in_w == 8'sd0)
            assert (out_w == 32'sd0)
                else $error("Zero input did not produce zero output");

        // ----------------------------------------------------
        // 3. SIGN MONOTONICITY
        // ----------------------------------------------------
        if (in_w > 8'sd0)
            assert (out_w >= 32'sd0)
                else $error("Positive input produced negative output");

        if (in_w < 8'sd0)
            assert (out_w <= 32'sd0)
                else $error("Negative input produced positive output");

        // ----------------------------------------------------
        // 4. NO UNINTENDED SATURATION
        // ----------------------------------------------------
        // Decompressor must never clamp values
        if (in_w != 8'sd0)
            assert (out_w != 32'sd0)
                else $error("Non-zero input collapsed to zero");

    end

endmodule

