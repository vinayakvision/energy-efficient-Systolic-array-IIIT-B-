// ============================================================
// Formal Properties for systolic_core
// ============================================================

module core_properties (
    input logic        clk,
    input logic        rst,

    input logic [31:0] inP1, inP5, inP9, inP13,
    input logic [63:0] Re1, Re2, Re3, Re4
);

    // ========================================================
    // 1. RESET CORRECTNESS
    // ========================================================

    assert property (@(posedge clk)
        rst |-> (Re1 == 64'd0 && Re2 == 64'd0 &&
                 Re3 == 64'd0 && Re4 == 64'd0)
    );

    // ========================================================
    // 2. OUTPUT STABILITY UNDER STABLE INPUTS
    // ========================================================

    // If inputs are stable and reset is low, outputs must settle
    assert property (@(posedge clk)
        disable iff (rst)
        $stable(inP1) && $stable(inP5) &&
        $stable(inP9) && $stable(inP13)
        |-> ##[1:3] ($stable(Re1) && $stable(Re2) &&
                     $stable(Re3) && $stable(Re4))
    );

    // ========================================================
    // 3. MONOTONIC ACCUMULATION SAFETY
    // ========================================================

    // Accumulated results must not change sign randomly
    assert property (@(posedge clk)
        disable iff (rst)
        (Re1[63] == $past(Re1[63])) ||
        (Re1 == 64'd0)
    );

    assert property (@(posedge clk)
        disable iff (rst)
        (Re2[63] == $past(Re2[63])) ||
        (Re2 == 64'd0)
    );

    assert property (@(posedge clk)
        disable iff (rst)
        (Re3[63] == $past(Re3[63])) ||
        (Re3 == 64'd0)
    );

    assert property (@(posedge clk)
        disable iff (rst)
        (Re4[63] == $past(Re4[63])) ||
        (Re4 == 64'd0)
    );

    // ========================================================
    // 4. LIVENESS / ACTIVITY (NON-DEAD PATH)
    // ========================================================

    // If any input is non-zero, eventually some output changes
    cover property (@(posedge clk)
        disable iff (rst)
        (inP1 != 0 || inP5 != 0 || inP9 != 0 || inP13 != 0)
        ##[1:8]
        (Re1 != 0 || Re2 != 0 || Re3 != 0 || Re4 != 0)
    );

    // ========================================================
    // 5. STRUCTURAL COVERAGE
    // ========================================================

    // Show that all outputs can become non-zero
    cover property (@(posedge clk) Re1 != 0);
    cover property (@(posedge clk) Re2 != 0);
    cover property (@(posedge clk) Re3 != 0);
    cover property (@(posedge clk) Re4 != 0);

endmodule

